    "@mdx-js/react": "^3.1.0",
    "asciidoctor": "^3.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.0.0",
    "glob": "^13.0.0",
    "lodash.merge": "^4.6.2",
    "node-html-markdown": "^2.0.0",
    "prism-react-renderer": "^2.4.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-multi-carousel": "^2.8.5",
    "remark-deflist": "^1.0.0",
    "typescript": "~5.9.0"
